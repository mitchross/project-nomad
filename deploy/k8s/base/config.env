NODE_ENV=production
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# URL must be the address you will access the Command Center at in your browser
# (e.g. https://nomad.example.com). Used to build links in the UI.
URL=http://localhost:8080
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nomad
DB_USER=nomad_user
DB_NAME=nomad
DB_SSL=false
REDIS_HOST=redis
REDIS_PORT=6379
# Most ingress controllers handle compression; leave false unless it causes issues
DISABLE_COMPRESSION=false
# Creator Packs (gated content downloads): official release images have the
# entitlement key baked in at build time. A source-built image needs it
# provided here for pack installs to work; leave unset otherwise (pack
# installs fail with a clear "not configured" error and nothing else is
# affected). CREATOR_PACKS_WORKER_BASE overrides the entitlement endpoint.
# CREATOR_PACKS_APP_KEY=
# CREATOR_PACKS_WORKER_BASE=
